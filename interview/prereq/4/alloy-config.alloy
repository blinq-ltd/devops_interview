discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["observability"]
  }
}

discovery.relabel "generator" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "synthetic-generator"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_ip"]
    regex         = "(.+)"
    target_label  = "__address__"
    replacement   = "${1}:9090"
  }
}

prometheus.scrape "generator" {
  targets         = discovery.relabel.generator.output
  forward_to      = [prometheus.relabel.generator.receiver]
  scrape_interval = "10s"
  scrape_timeout  = "5s"
  job_name        = "synthetic-generator"
}

prometheus.relabel "generator" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://kube-prometheus-stack-prometheus.observability.svc.cluster.local:9090/api/v1/write"
  }
}

loki.source.kubernetes "pods" {
  targets    = discovery.kubernetes.pods.targets
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki-gateway.observability.svc.cluster.local/loki/api/v1/push"
  }
}
