# Copy to terraform.tfvars (gitignored) and fill in before applying.
# Get the workstation_* values from: cd ../workstation && terraform output

cluster_admins = [
  "arn:aws:iam::123456789012:user/your-iam-user",
]

workstation_iam_role_arn      = "arn:aws:iam::123456789012:role/devops-interview-workstation-candidate-role"
workstation_vpc_id            = "vpc-xxxxxxxxxxxxxxxxx"
workstation_vpc_cidr          = "172.31.0.0/16"
workstation_security_group_id = "sg-xxxxxxxxxxxxxxxxx"
